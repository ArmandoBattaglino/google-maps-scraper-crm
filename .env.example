# Tutto facoltativo: senza questo file funziona lo stesso. Per usarlo, copialo in .env
# Il nome del CRM, come appare nell'app
APP_NOME=CRM
# La porta dell'app
PORTA=5330
# Dove ascolta: 127.0.0.1 = solo questa macchina. Non c'è un login: vedi «Portarlo su un server» nel README
BIND_IP=127.0.0.1
# Altri nomi con cui si può aprire il CRM, separati da virgole (es. crm.miodominio.it)
CONSENTI_HOST=
